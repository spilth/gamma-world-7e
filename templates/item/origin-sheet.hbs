<section class="origin-sheet-body">
  <h1>{{item.name}}</h1>

  <p class="all-caps">{{item.system.summary}}</p>

  {{#if item.system.description}}
    <p>{{item.system.description}}</p>
  {{/if}}

  <h3>Appearance</h3>

  <p>{{item.system.appearance}}</p>

  <h3>{{item.name}} Traits</h3>

  <p><strong>Mutant Type:</strong> {{ability}}</p>
</section>
