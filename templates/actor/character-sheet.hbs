<section class="character-sheet-body">
  <img
    class="token-img"
    data-action="configurePrototypeToken"
    src="{{actor.prototypeToken.texture.src}}"
    alt="{{actor.name}}"
  />

  <div class="form-group">
    <label>Name</label>
    <input type="text" name="name" value="{{actor.name}}" />
  </div>

  <div class="form-group">
    <label>Level</label>
    <input type="number" name="system.level" value="{{actor.system.level}}" />
  </div>

  <div class="form-group">
    <label>Primary Origin</label>
    <div class="origin-slot" data-origin-slot="primaryOrigin">
      {{#if primaryOrigin}}<a data-action="openOrigin">{{primaryOrigin}}</a>{{else}}Drop Origin Here{{/if}}
    </div>
  </div>

  <div class="form-group">
    <label>Secondary Origin</label>
    <div class="origin-slot" data-origin-slot="secondaryOrigin">
      {{#if secondaryOrigin}}<a data-action="openOrigin">{{secondaryOrigin}}</a>{{else}}Drop Origin Here{{/if}}
    </div>
  </div>

  <button type="button" data-action="rollOrigins" data-tooltip="Roll Origins">
    <i class="fa-solid fa-dice-d20"></i>
  </button>

  <div class="abilities">
    <div class="ability">
      <label>Strength</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.str" value="{{actor.system.abilities.str}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.str sign=true}}</span>
      </div>
    </div>
    <div class="ability">
      <label>Constitution</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.con" value="{{actor.system.abilities.con}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.con sign=true}}</span>
      </div>
    </div>
    <div class="ability">
      <label>Dexterity</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.dex" value="{{actor.system.abilities.dex}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.dex sign=true}}</span>
      </div>
    </div>
    <div class="ability">
      <label>Intelligence</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.int" value="{{actor.system.abilities.int}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.int sign=true}}</span>
      </div>
    </div>
    <div class="ability">
      <label>Wisdom</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.wis" value="{{actor.system.abilities.wis}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.wis sign=true}}</span>
      </div>
    </div>
    <div class="ability">
      <label>Charisma</label>
      <div class="ability-score">
        <input type="number" name="system.abilities.cha" value="{{actor.system.abilities.cha}}" />
        <span class="ability-modifier">{{numberFormat actor.system.abilityModifiers.cha sign=true}}</span>
      </div>
    </div>
  </div>

  <h3>Skills</h3>

  <table class="skills">
    <thead>
      <tr>
        <th>Skill</th>
        <th>Key Ability</th>
        <th>Ability Bonus</th>
        <th>Origin Bonus</th>
        <th>Level 1 Bonus</th>
        <th>Level Bonus</th>
        <th>Overall Bonus</th>
      </tr>
    </thead>
    <tbody>
      {{#each skills}}
        <tr>
          <td>{{label}}</td>
          <td>{{ability}}</td>
          <td>{{#if abilityBonus}}{{numberFormat abilityBonus sign=true}}{{/if}}</td>
          <td>{{#if originBonus}}{{numberFormat originBonus sign=true}}{{/if}}</td>
          <td>{{#if level1Bonus}}{{numberFormat level1Bonus sign=true}}{{/if}}</td>
          <td>{{#if levelBonus}}{{numberFormat levelBonus sign=true}}{{/if}}</td>
          <td><strong>{{numberFormat total sign=true}}</strong></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>