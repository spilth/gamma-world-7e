<section class="character-sheet-body">
    <img
            class="token-img"
            data-action="configurePrototypeToken"
            src="{{actor.prototypeToken.texture.src}}"
            alt="{{actor.name}}"
    />

    <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" value="{{actor.name}}"/>
    </div>

</section>